# Topic: Contact Book Application (Interactive Dictionary Maintenance Loop)
contacts = {}

while True:
    print("\n--- Contact Book ---")
    print("1. Add Contact\n2. Search Contact\n3. Delete Contact\n4. Display Contacts\n5. Exit")
    choice = input("Enter choice: ")
    
    if choice == '1':
        name = input("Enter name: ")
        phone = input("Enter phone number: ")
        contacts[name] = phone
        print("Contact saved.")
    elif choice == '2':
        name = input("Enter name to search: ")
        print("Phone:", contacts.get(name, "Not found"))
    elif choice == '3':
        name = input("Enter name to delete: ")
        if name in contacts:
            del contacts[name]
            print("Contact deleted.")
        else:
            print("Not found.")
    elif choice == '4':
        print("All Contacts:", contacts)
    elif choice == '5':
        break
