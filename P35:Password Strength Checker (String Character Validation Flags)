# Topic: Password Strength Checker (String Character Validation Flags)
def check_password_strength(password):
    has_digit = False
    has_upper = False
    has_lower = False
    
    if len(password) < 8:
        return "Weak (Must be at least 8 characters long)"
        
    for char in password:
        if char.isdigit(): has_digit = True
        if char.isupper(): has_upper = True
        if char.islower(): has_lower = True
        
    if has_digit and has_upper and has_lower:
        return "Strong Password!"
    else:
        return "Weak (Missing uppercase, lowercase, or digit)"

user_pwd = input("Enter a password to check: ")
print(check_password_strength(user_pwd))
