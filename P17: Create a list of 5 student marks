# Create a list of 5 student marks
marks = [78, 85, 92, 64, 89]

# Perform operations
marks.append(95)          # Adds 95 to the end
marks.insert(2, 70)       # Inserts 70 at index 2
marks.remove(64)          # Removes the element 64
marks.sort()              # Sorts the list in ascending order

# Print updated list
print("Updated Marks:", marks)
